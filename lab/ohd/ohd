#!/usr/bin/env python3
"""Omni Head Display (OHD) — router CLI. Not a codec.

v1 law: race available seats, keep the smallest DECODE_OK blob.
Ties go to scout. Never label sniper Fast.
"""
from __future__ import annotations

import json
import math
import os
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

MAGIC = b"OHD1"
ROOT = Path(__file__).resolve().parent
DEFAULT_SNIPER_MAX = 4 * 1024 * 1024
DEFAULT_TIMEOUT = 30.0


def _env_int(name: str, default: int) -> int:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        return int(raw, 10)
    except ValueError:
        print(f"OHD: bad {name}={raw!r}; using {default}", file=sys.stderr)
        return default


def _env_float(name: str, default: float) -> float:
    raw = os.environ.get(name)
    if raw is None or raw.strip() == "":
        return default
    try:
        return float(raw)
    except ValueError:
        print(f"OHD: bad {name}={raw!r}; using {default}", file=sys.stderr)
        return default


def _truthy(name: str) -> bool:
    return os.environ.get(name, "").strip().lower() in ("1", "true", "yes", "on")


def pick_mode() -> str:
    mode = os.environ.get("OHD_PICK", "smallest").strip().lower()
    if mode not in ("smallest", "first"):
        print(f"OHD: bad OHD_PICK={mode!r}; using smallest", file=sys.stderr)
        return "smallest"
    return mode


def sniper_max_bytes() -> int:
    return _env_int("OHD_SNIPER_MAX_BYTES", DEFAULT_SNIPER_MAX)


def seat_timeout(seat_id: str) -> float:
    if seat_id == "sniper":
        return _env_float("OHD_SNIPER_TIMEOUT_SEC", DEFAULT_TIMEOUT)
    return _env_float("OHD_SCOUT_TIMEOUT_SEC", DEFAULT_TIMEOUT)


def sniper_allowed(n: int) -> tuple[bool, str]:
    if _truthy("OHD_SNIPER_FORCE"):
        return True, "force"
    cap = sniper_max_bytes()
    if n > cap:
        return False, f"size {n} > OHD_SNIPER_MAX_BYTES={cap}"
    return True, "ok"


def _resolve_scout() -> Path | None:
    env = os.environ.get("OHD_SCOUT")
    if env:
        p = Path(env)
        return p if p.is_file() else None
    p = ROOT / "bin" / "scout-dial-a"
    return p if p.is_file() else None


def _resolve_sniper() -> Path | None:
    for key in ("OHD_SNIPER", "SNIPER_BIN"):
        env = os.environ.get(key)
        if env:
            p = Path(env)
            return p if p.is_file() else None
    which = shutil.which("npcc")
    return Path(which) if which else None


def peek(data: bytes) -> dict[str, Any]:
    n = len(data)
    sample = data if n <= 65536 else data[:65536]
    hist = [0] * 256
    for b in sample:
        hist[b] += 1
    m = len(sample) or 1
    ent = 0.0
    for c in hist:
        if c:
            p = c / m
            ent -= p * math.log2(p)
    zeros = hist[0] / m
    ascii_n = sum(hist[i] for i in range(256) if i in (9, 10, 13) or 32 <= i < 127)
    return {
        "size": n,
        "entropy_proxy": round(ent, 4),
        "zero_frac": round(zeros, 4),
        "ascii_frac": round(ascii_n / m, 4),
        "magic": sample[:8].hex() if sample else "",
    }


def _run_seat(bin_path: Path, mode: str, inp: Path, out: Path, timeout: float) -> None:
    try:
        r = subprocess.run(
            [str(bin_path), mode, str(inp), str(out)],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as e:
        raise RuntimeError(
            f"seat {bin_path.name} {mode} timeout after {timeout}s"
        ) from e
    if r.returncode != 0:
        raise RuntimeError(
            f"seat {bin_path.name} {mode} failed rc={r.returncode}: {r.stderr or r.stdout}"
        )
    if not out.is_file() or out.stat().st_size == 0:
        raise RuntimeError(f"seat {bin_path.name} {mode} produced empty output")


def try_seat(
    seat_id: str, bin_path: Path, raw: bytes, work: Path, timeout: float
) -> tuple[bytes, dict] | None:
    """Encode → decode → cmp. Return (packed, meta) on DECODE_OK else None."""
    raw_path = work / "raw.bin"
    packed_path = work / f"{seat_id}.packed"
    back_path = work / f"{seat_id}.back"
    raw_path.write_bytes(raw)
    t0 = time.monotonic()
    try:
        _run_seat(bin_path, "c", raw_path, packed_path, timeout)
        _run_seat(bin_path, "d", packed_path, back_path, timeout)
    except RuntimeError as e:
        print(f"OHD: seat={seat_id} FAIL encode/decode: {e}", file=sys.stderr)
        return None
    elapsed = time.monotonic() - t0
    back = back_path.read_bytes()
    if back != raw:
        print(
            f"OHD: seat={seat_id} FAIL DECODE gate (len {len(back)} vs {len(raw)})",
            file=sys.stderr,
        )
        return None
    packed = packed_path.read_bytes()
    if len(packed) >= len(raw):
        print(
            f"OHD: seat={seat_id} DECODE_OK but no shrink ({len(packed)} >= {len(raw)}); skip",
            file=sys.stderr,
        )
        return None
    meta = {
        "magic": "OHD1",
        "seat": seat_id,
        "raw_size": len(raw),
        "packed_size": len(packed),
        "decode_ok": True,
        "elapsed_sec": round(elapsed, 4),
        "label": seat_id,  # honest: never "fast" for sniper
    }
    return packed, meta


def seat_try_list(n: int) -> tuple[list[tuple[str, Path]], list[dict]]:
    seats: list[tuple[str, Path]] = []
    skipped: list[dict] = []
    scout = _resolve_scout()
    if scout is not None and os.access(scout, os.X_OK):
        seats.append(("scout", scout))
    else:
        print("OHD: scout PARKED (no Dial A / PCC binary) — try sniper", file=sys.stderr)
        skipped.append({"seat": "scout", "reason": "parked"})
    sniper = _resolve_sniper()
    if sniper is not None and os.access(sniper, os.X_OK):
        ok, why = sniper_allowed(n)
        if ok:
            seats.append(("sniper", sniper))
        else:
            print(f"OHD: sniper SKIP {why}", file=sys.stderr)
            skipped.append({"seat": "sniper", "reason": why})
    else:
        print("OHD: sniper missing (set OHD_SNIPER or put npcc on PATH)", file=sys.stderr)
        skipped.append({"seat": "sniper", "reason": "missing"})
    return seats, skipped


def _tie_rank(seat_id: str) -> int:
    # Lower wins ties. Scout is the fast seat; sniper is never preferred on a tie.
    return 0 if seat_id == "scout" else 1


def frame_write(meta: dict, packed: bytes) -> bytes:
    meta_bytes = json.dumps(meta, separators=(",", ":")).encode("utf-8")
    return MAGIC + struct.pack(">I", len(meta_bytes)) + meta_bytes + packed


def frame_read(blob: bytes) -> tuple[dict, bytes]:
    if len(blob) < 8 or blob[:4] != MAGIC:
        raise ValueError("not an OHD1 frame")
    (mlen,) = struct.unpack(">I", blob[4:8])
    if 8 + mlen > len(blob):
        raise ValueError("truncated OHD1 meta")
    meta = json.loads(blob[8 : 8 + mlen].decode("utf-8"))
    packed = blob[8 + mlen :]
    return meta, packed


def cmd_compress(inp: Path, out: Path) -> int:
    raw = inp.read_bytes()
    features = peek(raw)
    seats, skipped = seat_try_list(len(raw))
    if not seats:
        print("OHD: no seats available", file=sys.stderr)
        return 2
    mode = pick_mode()
    winners: list[tuple[bytes, dict]] = []
    raced: list[dict] = []
    with tempfile.TemporaryDirectory(prefix="ohd-") as td:
        work = Path(td)
        for seat_id, bin_path in seats:
            timeout = seat_timeout(seat_id)
            result = try_seat(seat_id, bin_path, raw, work, timeout)
            if result is None:
                raced.append({"seat": seat_id, "decode_ok": False})
                if mode == "first":
                    continue
                continue
            packed, meta = result
            raced.append(
                {
                    "seat": seat_id,
                    "decode_ok": True,
                    "packed_size": meta["packed_size"],
                    "elapsed_sec": meta["elapsed_sec"],
                }
            )
            if mode == "first":
                winners = [(packed, meta)]
                break
            winners.append((packed, meta))
        if not winners:
            print("OHD: no DECODE_OK from any seat", file=sys.stderr)
            return 1
        packed, meta = min(
            winners, key=lambda t: (t[1]["packed_size"], _tie_rank(t[1]["seat"]))
        )
        meta["peek"] = features
        meta["pick"] = mode
        meta["raced"] = raced
        if skipped:
            meta["skipped"] = skipped
        out.write_bytes(frame_write(meta, packed))
        print(
            f"seat={meta['seat']} DECODE_OK raw={meta['raw_size']} "
            f"packed={meta['packed_size']} pick={mode} raced={len(raced)}"
        )
        return 0


def cmd_decompress(framed: Path, raw_out: Path) -> int:
    blob = framed.read_bytes()
    meta, packed = frame_read(blob)
    seat = meta.get("seat")
    if seat == "sniper":
        bin_path = _resolve_sniper()
        if bin_path is None:
            print("OHD: frame seat=sniper but sniper binary not found", file=sys.stderr)
            return 2
    elif seat == "scout":
        bin_path = _resolve_scout()
        if bin_path is None:
            print("OHD: frame seat=scout but Scout PARKED", file=sys.stderr)
            return 2
    else:
        print(f"OHD: unknown seat {seat!r}", file=sys.stderr)
        return 2
    with tempfile.TemporaryDirectory(prefix="ohd-d-") as td:
        work = Path(td)
        packed_path = work / "packed"
        back_path = work / "back"
        packed_path.write_bytes(packed)
        try:
            _run_seat(bin_path, "d", packed_path, back_path, seat_timeout(str(seat)))
        except RuntimeError as e:
            print(f"OHD: decompress fail: {e}", file=sys.stderr)
            return 1
        raw = back_path.read_bytes()
        if meta.get("raw_size") is not None and len(raw) != int(meta["raw_size"]):
            print("OHD: size mismatch vs meta", file=sys.stderr)
            return 1
        raw_out.write_bytes(raw)
        print(f"seat={seat} DECODE_OK raw={len(raw)}")
        return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(
            "usage: ohd compress <in> <out>\n       ohd decompress <out> <raw>",
            file=sys.stderr,
        )
        return 2
    cmd = argv[1]
    if cmd == "compress":
        if len(argv) != 4:
            print("usage: ohd compress <in> <out>", file=sys.stderr)
            return 2
        return cmd_compress(Path(argv[2]), Path(argv[3]))
    if cmd == "decompress":
        if len(argv) != 4:
            print("usage: ohd decompress <out> <raw>", file=sys.stderr)
            return 2
        return cmd_decompress(Path(argv[2]), Path(argv[3]))
    print(f"unknown command: {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
