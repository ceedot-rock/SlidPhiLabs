#!/usr/bin/env bash
# Scout = Dial A / PCC. First DECODE_OK Fast seat.
set -euo pipefail
LB="${SCOUT_LB:-${LB:-lb}}"
PROFILE="${SCOUT_PROFILE:-quality}"
export LBR1_PARSE="${LBR1_PARSE:-hc4}"
export LBR1_WINDOW="${LBR1_WINDOW:-1048576}"
export LBR1_CHAIN="${LBR1_CHAIN:-8}"
export LBR1_LAZY="${LBR1_LAZY:-0}"
export LBR1_PACK="${LBR1_PACK:-ml4}"
export LBR1_HASH="${LBR1_HASH:-17}"
export LBR1_INSERT="${LBR1_INSERT:-dense}"
export LBR1_FIND="${LBR1_FIND:-price}"
case "$PROFILE" in
  fast) export PCC_OPEN_RATIO="${PCC_OPEN_RATIO:-0.99}" ;;
  quality|qual) export PCC_OPEN_RATIO="${PCC_OPEN_RATIO:-0.31}" ;;
  *) echo "scout-dial-a: unknown SCOUT_PROFILE=$PROFILE" >&2; exit 2 ;;
esac
[[ $# -eq 3 ]] || { echo "usage: scout-dial-a c|d <in> <out>" >&2; exit 2; }
mode=$1; inp=$2; out=$3
if ! command -v "$LB" >/dev/null 2>&1 && [[ ! -x "$LB" ]]; then
  echo "scout-dial-a: lb not found" >&2; exit 1
fi
[[ -f "$inp" ]] || { echo "scout-dial-a: input not found: $inp" >&2; exit 1; }
case "$mode" in
  c) "$LB" pcc "$inp" "$out" >/dev/null; [[ -s "$out" ]] || exit 1 ;;
  d) "$LB" decode "$inp" "$out"; [[ -f "$out" ]] || exit 1 ;;
  *) exit 2 ;;
esac
