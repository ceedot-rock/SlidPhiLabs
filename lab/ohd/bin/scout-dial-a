#!/usr/bin/env bash
# Scout = Dial A / PCC (lbr1). OHD seat CLI: c|d <in> <out>
set -euo pipefail
LB="${SCOUT_LB:-${LB:-lb}}"
export LBR1_PARSE=hc4
export LBR1_WINDOW=1048576
export LBR1_CHAIN=8
export LBR1_LAZY=0
export LBR1_PACK=ml4
export LBR1_HASH=17
export LBR1_INSERT=dense
export LBR1_FIND=price

usage() {
  echo "usage: scout-dial-a c <in> <out>" >&2
  echo "       scout-dial-a d <in> <out>" >&2
  exit 2
}

[[ $# -eq 3 ]] || usage
mode=$1
inp=$2
out=$3

# Resolve lb from PATH when not an absolute/existing path
if [[ ! -x "$LB" ]]; then
  if command -v "$LB" >/dev/null 2>&1; then
    LB=$(command -v "$LB")
  else
    echo "scout-dial-a: lb not found (set SCOUT_LB or LB, or put lb on PATH)" >&2
    exit 1
  fi
fi
[[ -f "$inp" ]] || { echo "scout-dial-a: input not found: $inp" >&2; exit 1; }

case "$mode" in
  c)
    # lb pcc IN OUT → PCC1 bytes (Dial A env above)
    "$LB" pcc "$inp" "$out" >/dev/null
    [[ -s "$out" ]] || { echo "scout-dial-a: encode produced empty output" >&2; exit 1; }
    ;;
  d)
    # lb decode handles PCC1 via splb::decode
    "$LB" decode "$inp" "$out"
    [[ -f "$out" ]] || { echo "scout-dial-a: decode produced no file" >&2; exit 1; }
    ;;
  *)
    usage
    ;;
esac
