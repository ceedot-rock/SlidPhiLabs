  "redirects": [
    {
      "source": "/",
      "has": [{"type": "host", "value": "slidphilabs.com"}],
      "destination": "https://www.slidphilabs.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{"type": "host", "value": "slidphilabs.com"}],
      "destination": "https://www.slidphilabs.com/:path*",
      "permanent": true
    },
    {
      "source": "/try.html",
